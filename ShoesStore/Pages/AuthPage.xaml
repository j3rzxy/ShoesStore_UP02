<Page x:Class="ShoesStore.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Авторизация" FontSize="30" Margin="0 0 0 20" HorizontalAlignment="Center"/>
            <TextBlock Text="Логин" Width="250"/>
            <TextBox x:Name="LoginBox" Width="250" ToolTip="Введите логин" />
            <TextBlock Text="Пароль" Width="250" Margin="0 10 0 0"/>
            <PasswordBox x:Name="LogPassBox" Width="250" ToolTip="Введите пароль"/>
            <Button Content="Войти" Margin="0 20 0 0" Click="Login" Width="250"/>
            <Button Content="Создать аккаунт" Background="Transparent" BorderThickness="0" Foreground="DodgerBlue" Cursor="Hand" Click="LabelButton_Click" HorizontalAlignment="Center" Margin="0 20 0 0"/>
            <Button Content="Войти в режиме Гостя" Background="Transparent" BorderThickness="0" Foreground="DodgerBlue" Cursor="Hand" Click="GuestButton_Click" HorizontalAlignment="Center" Margin="0 20 0 0"/>
        </StackPanel>
    </Grid>
</Page>

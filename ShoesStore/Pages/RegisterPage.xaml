<Page x:Class="ShoesStore.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Регистрация" FontSize="30" Margin="0 0 0 20" HorizontalAlignment="Center"/>
            <TextBlock Text="Роль" Width="250"/>
            <ComboBox x:Name="RoleComboBox" Width="250" ToolTip="Выберите роль" DisplayMemberPath="Name" SelectedValuePath="ID" />
            <TextBlock Text="ФИО" Width="250" Margin="0 10 0 0"/>
            <TextBox x:Name="FullNameBox" Width="250" ToolTip="Введите ФИО" />
            <TextBlock Text="Логин" Width="250" Margin="0 10 0 0"/>
            <TextBox x:Name="RegLoginBox" Width="250" ToolTip="Введите логин" />
            <TextBlock Text="Пароль" Width="250" Margin="0 10 0 0"/>
            <PasswordBox x:Name="RegPassBox" Width="250" ToolTip="Введите пароль"/>
            <TextBlock Text="Подтвердите пароль" Width="250" Margin="0 10 0 0"/>
            <PasswordBox x:Name="ConfirmPassBox" Width="250" ToolTip="Подтвердите пароль"/>
            <Button Content="Зарегистрироваться" Margin="0 20 0 0" Click="Register" Width="250"/>
            <Button Content="Войти в аккаунт" Background="Transparent" BorderThickness="0" Foreground="DodgerBlue" Cursor="Hand" Click="LabelButton_Click" HorizontalAlignment="Center" Margin="0 20 0 0"/>
            <Button Content="Войти в режиме Гостя" Background="Transparent" BorderThickness="0" Foreground="DodgerBlue" Cursor="Hand" Click="GuestRegButton_Click" HorizontalAlignment="Center" Margin="0 20 0 0"/>
        </StackPanel>
    </Grid>
</Page>
